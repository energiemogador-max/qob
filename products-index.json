  "glossary": {
    "djellaba": {
      "term": {
        "fr": "Djellaba",
        "ar": "جلابة",
        "en": "Djellaba"
      },
      "definition": {
        "fr": "Robe longue et ample à manches longues, fendue sur les côtés, avec un qob. Portée par les hommes comme par les femmes.",
        "ar": "ثوب طويل واسع بأكمام طويلة وقلنسوة مدبّبة.",
        "en": "A long, loose robe with full sleeves, split at the sides, with a qob. Worn by men and women alike."
      }
    },
    "caftan": {
      "term": {
        "fr": "Caftan",
        "ar": "قفطان",
        "en": "Caftan"
      },
      "definition": {
        "fr": "Robe longue sans capuche, fermée par une rangée d'aqad sur le devant. Elle se porte à l'intérieur, contrairement à la djellaba.",
        "ar": "ثوب طويل بلا قلنسوة، يُغلق بصف من العقاد.",
        "en": "A long hoodless robe closed by a row of aqad down the front. Unlike the djellaba it is worn indoors."
      }
    },
    "jabador": {
      "term": {
        "fr": "Jabador",
        "ar": "جابادور",
        "en": "Jabador"
      },
      "definition": {
        "fr": "Ensemble deux pièces : tunique courte et pantalon assorti, plus léger que la djellaba.",
        "ar": "طقم من قطعتين: قميص قصير وسروال.",
        "en": "A two-piece set — short tunic and matching trousers, lighter than a djellaba."
      }
    },
    "gandoura": {
      "term": {
        "fr": "Gandoura",
        "ar": "قندورة",
        "en": "Gandoura"
      },
      "definition": {
        "fr": "Tunique ample sans manches ni capuche, coupée droit. La pièce d'été.",
        "ar": "قميص واسع بلا أكمام ولا قلنسوة.",
        "en": "A wide sleeveless, hoodless tunic cut straight. The summer piece."
      }
    },
    "sfifa": {
      "term": {
        "fr": "Sfifa",
        "ar": "سفيفة",
        "en": "Sfifa"
      },
      "definition": {
        "fr": "Galon plat tressé à la main, appliqué le long des ouvertures d'un vêtement — encolure, poches, fentes. Il ferme le bord du tissu et le renforce.",
        "ar": "شريط مضفور يدوياً يُطبَّق على فتحات الثوب.",
        "en": "A flat hand-braided trim applied along a garment's openings — neckline, pockets, side vents. It closes and reinforces the raw edge."
      }
    },
    "aqad": {
      "term": {
        "fr": "Aqad",
        "ar": "عقاد",
        "en": "Aqad"
      },
      "definition": {
        "fr": "Bouton noué à la main dans le même galon que la sfifa, avec sa boucle. Il n'y a pas de bouton rapporté : la fermeture est du fil.",
        "ar": "زر معقود يدوياً من نفس الشريط، مع عروته.",
        "en": "A knot button hand-tied from the same braid as the sfifa, with its own loop. Nothing is attached — the fastening is thread."
      }
    },
    "qob": {
      "term": {
        "fr": "Qob",
        "ar": "قب",
        "en": "Qob"
      },
      "definition": {
        "fr": "La capuche pointue de la djellaba. Elle est coupée en pointe et tombe dans le dos quand elle n'est pas portée.",
        "ar": "قلنسوة الجلابة المدبّبة.",
        "en": "The pointed hood of a djellaba. Cut to a point, it falls down the back when not worn up."
      }
    },
    "mlifa": {
      "term": {
        "fr": "Mlifa",
        "ar": "مليفة",
        "en": "Mlifa"
      },
      "definition": {
        "fr": "Drap de laine épais et feutré du Moyen Atlas, tissé pour l'hiver.",
        "ar": "قماش صوفي سميك من الأطلس المتوسط.",
        "en": "A thick fulled wool cloth from the Middle Atlas, woven for winter."
      }
    },
    "selham": {
      "term": {
        "fr": "Selham",
        "ar": "سلهام",
        "en": "Selham"
      },
      "definition": {
        "fr": "Cape ample à capuche, sans manches, portée par-dessus. Aussi appelée burnous.",
        "ar": "عباءة واسعة بقلنسوة، بلا أكمام.",
        "en": "A wide hooded cape with no sleeves, worn over everything else. Also called a burnous."
      }
    }
  },
  "care_terms": {
    "dry-clean": {
